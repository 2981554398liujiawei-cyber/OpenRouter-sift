{
  "name": "openrouter-provider-shim",
  "version": "1.0.0-rc.1",
  "description": "OpenRouter Sift — local control plane for OpenRouter: manage desired models, provider filters, API keys and routing from a browser UI, with verified Codex / Claude Code / OpenCode support.",
  "type": "module",
  "bin": {
    "openrouter-sift": "dist/server/cli.js",
    "openrouter-provider-shim": "dist/server/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:server": "tsup src/cli.ts --format esm --dts --clean --out-dir dist/server",
    "build:ui": "vite build",
    "prepack": "npm run build",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "npm run build:server && node --watch dist/server/cli.js serve --port 8787",
    "dev:ui": "vite build --watch",
    "start": "node dist/server/cli.js serve --port 8787",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.0.0",
    "jsdom": "^24.1.3",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "openrouter",
    "claude-code",
    "openai",
    "proxy",
    "provider-routing",
    "shim",
    "control-plane",
    "local-first",
    "sift"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/server",
    "dist/ui",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2981554398liujiawei-cyber/OpenRouter-sift.git"
  },
  "homepage": "https://github.com/2981554398liujiawei-cyber/OpenRouter-sift",
  "bugs": {
    "url": "https://github.com/2981554398liujiawei-cyber/OpenRouter-sift/issues"
  }
}
